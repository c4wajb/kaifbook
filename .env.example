DATABASE_URL="postgresql://kaifbook:password@localhost:5432/kaifbook"
SESSION_SECRET="replace-with-a-long-random-string"
AI_PROVIDER="mock"

# Public base URL for messenger confirmation links.
APP_PUBLIC_URL="http://localhost:3000"

# MAX confirmation integration. Keep tokens server-side only.
MAX_BOT_TOKEN=""
MAX_BOT_USERNAME=""
MAX_WEBHOOK_SECRET=""
MAX_API_BASE_URL="https://platform-api.max.ru"

# VK confirmation integration. Keep tokens server-side only.
VK_GROUP_ID=""
VK_GROUP_SCREEN_NAME=""
VK_COMMUNITY_TOKEN=""
VK_CONFIRMATION_CODE=""
VK_CALLBACK_SECRET=""
VK_API_VERSION="5.199"
VERIFICATION_PHONE_LIMIT_COUNT="8"
VERIFICATION_IP_LIMIT_COUNT="30"

# VK ID login for guest cabinet. Create a VK ID app and add this redirect URL in VK settings.
VK_ID_APP_ID=""
NEXT_PUBLIC_VK_ID_APP_ID=""
VK_ID_REDIRECT_URL="http://localhost:3000/api/guest-auth/vkid/callback"
VK_ID_SCOPE="email"
VK_ID_REQUIRE_PHONE_MATCH="false"

# VK Mini App. Use these in VK Mini Apps dashboard launch settings.
NEXT_PUBLIC_VK_APP_ID=""
VK_APP_ID=""
VK_APP_SECRET=""
VK_APP_SERVICE_TOKEN=""
NEXT_PUBLIC_VK_MINI_APP_URL="http://localhost:3000/vk-mini"
